# Server-only contact delivery. Never prefix these names with NEXT_PUBLIC_.
# Copy this template to .env.local for local development. Never commit real values.
# For Vercel, configure these names in the relevant project environment separately.

# Resend API key with permission to send email from the verified domain.
RESEND_API_KEY=

# Sender on the verified askold.me domain.
# Supports a bare address or a display name, e.g. ASKOLD <contact@askold.me>.
CONTACT_FROM_EMAIL=

# Inbox that receives contact inquiries (one email address).
CONTACT_TO_EMAIL=
